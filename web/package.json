{
  "name": "catalyst-code-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/require-node.mjs && node --import tsx src/server/server.ts",
    "build": "node scripts/require-node.mjs && node node_modules/next/dist/bin/next build && node scripts/write-version.mjs",
    "start": "node scripts/require-node.mjs && NODE_ENV=production node --import tsx src/server/server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test",
    "test:e2e": "node scripts/hub-regression.mjs",
    "test:e2e:hub": "node scripts/hub-regression.mjs"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.6.23",
    "@better-auth/passkey": "^1.6.23",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "better-auth": "^1.6.23",
    "ghostty-web": "^0.4.0",
    "kysely": "^0.29.3",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0",
    "zigpty": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.19",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
